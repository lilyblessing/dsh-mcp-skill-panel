{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@deepseek-ai/cordis": ["node_modules/@deepseek-ai/cordis/lib/types/index.d.ts"],
      "@deepseek-ai/schemastery": ["node_modules/@deepseek-ai/schemastery/lib/index.d.ts"],
      "@deepseek-ai/dsh-scope": ["node_modules/@deepseek-ai/dsh-scope/lib/types/index.d.ts"],
      "@deepseek-ai/dsh-tools": ["node_modules/@deepseek-ai/dsh-tools/lib/types/index.d.ts"],
      "@deepseek-ai/dsh-skill": ["node_modules/@deepseek-ai/dsh-skill/lib/types/index.d.ts"],
      "@deepseek-ai/dsh-agent": ["node_modules/@deepseek-ai/dsh-agent/lib/types/index.d.ts"],
      "@deepseek-ai/cordis-plugin-loader": ["node_modules/@deepseek-ai/cordis-plugin-loader/lib/types/index.d.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
